# ==========================================
# Backend Environment Variables (Example)
# ==========================================

APP_NAME=AI Portfolio
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
SECRET_KEY=your-super-secret-key-change-in-production

DATABASE_URL=postgresql+asyncpg://portfolio_user:portfolio_pass@localhost:5432/portfolio_db

# Ollama Cloud chatbot settings
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

RATE_LIMIT=10/minute

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

LOG_LEVEL=DEBUG

# Contact Email Delivery
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-password-or-app-password
SMTP_USE_TLS=true
CONTACT_RECEIVER_EMAIL=your-email@example.com
CONTACT_SENDER_EMAIL=no-reply@your-domain.com
